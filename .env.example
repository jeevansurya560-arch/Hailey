# ── Browser-safe (VITE_ prefix, never put secrets here) ─────────────────────
# Canonical App URL for Supabase Auth redirects (email confirmation, password recovery, OAuth).
# Leave unset or empty in local development to default to window.location.origin (http://localhost:5173).
# Set to your reachable staging or production HTTPS domain (e.g. https://staging.hailey.org or https://hailey.org)
# when testing on physical mobile devices or deploying to staging/production.
VITE_APP_URL=

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EXPLORER_URL=https://testnet.monadvision.com
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ── Server-only (Vercel Functions / local vercel dev) — NEVER prefix with VITE_ ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # SECRET — bypasses RLS
RELAYER_PRIVATE_KEY=0xyour-relayer-private-key        # SECRET — canonical relayer private key (testnet only)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
RELAYER_MIN_BALANCE=0.01
